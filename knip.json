{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-for-unpinned-dependencies.mjs",
        "scripts/check-agent-skills-in-sync.mjs",
        "scripts/*.ts"
      ],
      "project": ["scripts/**/*.mjs", "scripts/**/*.ts"]
    },
    "packages/backend": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/frontend": {
      "entry": [
        "src/index.tsx",
        "src/**/*.test.ts",
        "*.test.ts",
        "tooling/*.ts",
        "e2e/specs/**/*.spec.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "*.ts", "tooling/**/*.ts"]
    },
    "packages/shared-types": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@biomejs/biome", "markdownlint-cli2"]
}
