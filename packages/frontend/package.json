{
  "name": "@devopsrockstars/frontend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "bun tooling/build.ts",
    "start": "bun --watch tooling/server.ts",
    "start:test": "bun tooling/server.ts --port 8081",
    "start:staging": "PUBLIC_ENVIRONMENT=staging bun tooling/server.ts --port 8082",
    "test": "bun test --timeout 120000 e2e/specs",
    "test:headless": "HEADLESS=true bun test --timeout 120000 e2e/specs",
    "deploy:staging": "bun run --bun wrangler deploy --env staging",
    "deploy:prod": "bun run --bun wrangler deploy --env prod"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "expect-webdriverio": "7.0.1",
    "webdriverio": "9.32.0"
  },
  "dependencies": {
    "@devopsrockstars/shared-types": "workspace:*",
    "@stripe/stripe-js": "10.0.0",
    "chicago-skyline": "github:a2f0/skyline#d7406d2aadf64ec32d88954d297cc03379fe2dc2",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.4.0",
    "react-svg": "19.1.6",
    "styled-components": "6.5.3",
    "three": "0.186.1"
  }
}
