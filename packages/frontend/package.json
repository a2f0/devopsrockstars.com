{
  "name": "@devopsrockstars/frontend",
  "version": "0.1.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "bun tooling/build.ts",
    "start": "bun --watch tooling/server.ts",
    "start:test": "bun tooling/server.ts --port 8081",
    "start:staging": "PUBLIC_ENVIRONMENT=staging bun tooling/server.ts --port 8082",
    "test": "bun test --timeout 120000 e2e/specs",
    "test:headless": "HEADLESS=true bun test --timeout 120000 e2e/specs",
    "deploy:staging": "bun ../../scripts/deploy.ts staging --worker=frontend",
    "deploy:prod": "bun ../../scripts/deploy.ts prod --worker=frontend"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "expect-webdriverio": "8.0.0",
    "webdriverio": "10.0.2"
  },
  "dependencies": {
    "@a2f0/skyline": "0.2.27",
    "@devopsrockstars/shared-types": "workspace:*",
    "@stripe/stripe-js": "10.1.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-router": "8.4.0",
    "react-svg": "19.2.1",
    "styled-components": "6.6.0",
    "three": "0.186.1"
  }
}
