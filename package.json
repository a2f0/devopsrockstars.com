{
  "name": "devopsrockstars",
  "version": "2.0.68",
  "private": true,
  "description": "",
  "engines": {
    "bun": ">=1.4.2 <1.5"
  },
  "type": "module",
  "scripts": {
    "postinstall": "bun packages/frontend/node_modules/chicago-skyline/scripts/build-package.ts",
    "start-server": "bun run --filter @devopsrockstars/frontend start",
    "start-test-server": "bun run --filter @devopsrockstars/frontend start:test",
    "test": "bun run --filter @devopsrockstars/frontend test",
    "test-headless": "bun run --filter @devopsrockstars/frontend test:headless",
    "ci": "bun scripts/ci.ts",
    "ci-headless": "bun scripts/ci.ts --headless",
    "agent-tool": "agent-tool",
    "format": "bun run --bun biome format --write",
    "build": "bun run --filter @devopsrockstars/frontend build",
    "dev:cloudflare": "bun run --filter @devopsrockstars/backend dev",
    "db:migrate:local": "bun run --filter @devopsrockstars/backend db:migrate:local",
    "lint": "bun run --bun biome lint --fix",
    "lint:md": "bun run --bun markdownlint-cli2",
    "compile": "bun run --bun tsc --noEmit",
    "unit": "bun test --timeout 60000 packages/backend/src packages/frontend/src packages/frontend/buildAssets.test.ts packages/frontend/tooling",
    "deploy:staging": "bun scripts/deploy.ts staging",
    "deploy:prod": "bun scripts/deploy.ts prod",
    "db:migrate:staging": "bun run --filter @devopsrockstars/backend db:migrate:staging",
    "db:migrate:prod": "bun run --filter @devopsrockstars/backend db:migrate:prod",
    "start-staging-server": "bun run --filter @devopsrockstars/frontend start:staging",
    "version:patch": "bun scripts/version-bump.ts",
    "check:unused": "bun run --bun knip",
    "agents:sync": "bun run agent-tool skills install --apply",
    "agents:check": "bun run agent-tool skills check"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.2",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-tool": "github:a2f0/agent-tool#ef1a91300c347ac13a1cb163d85ad734bfe81bf9",
    "knip": "6.39.0",
    "markdownlint-cli2": "0.23.3",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [],
  "patchedDependencies": {
    "expect@30.5.2": "patches/expect@30.5.2.patch",
    "miniflare@5.20261001.0-alpha": "patches/miniflare@5.20261001.0-alpha.patch"
  }
}
